            },
            {
              "type": "text",
              "id": "dN995",
              "name": "Section Description",
              "fill": "$--muted-foreground",
              "textGrowth": "fixed-width",
              "width": 900,
              "content": "Generated from the variables above and checked against src/app/globals.css: same tokens, same @theme bridge, same autofill override. Fonts come from next/font: Roboto Slab as --font-roboto-slab and Roboto as --font-roboto.",
              "lineHeight": 1.5,
              "fontFamily": "$--font-body",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "TAcpF",
              "name": "Code Panel",
              "width": "fill_container",
              "fill": "$--background",
              "cornerRadius": "$--radius-xl",
              "stroke": "$--border",
              "strokeWidth": 1,
              "strokeAlignment": "inner",
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "f5o4YQ",
                  "name": "CSS",
                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "@import \"tailwindcss\";\n\n@custom-variant dark (&:is(.dark *));\n\n:root {\n  color-scheme: light;\n  --radius: 0.625rem;\n\n  --background: #f6f6fa;\n  --foreground: #15152b;\n  --card: #ffffff;\n  --card-foreground: #15152b;\n  --popover: #ffffff;\n  --popover-foreground: #15152b;\n  --primary: #5636d3;\n  --primary-foreground: #ffffff;\n  --primary-text: #5636d3;\n  --primary-soft: #eeeafc;\n  --secondary: #ececf3;\n  --secondary-foreground: #15152b;\n  --muted: #ececf3;\n  --muted-foreground: #656579;\n  --accent: #eeeafc;\n  --accent-foreground: #15152b;\n  --destructive: #d23b3b;\n  --destructive-foreground: #ffffff;\n  --border: #e6e6ef;\n  --input: #8a8aa3;\n  --ring: #5636d3;\n  --success: #107a52;\n  --success-soft: #e3f5ec;\n  --danger: #c43232;\n  --danger-soft: #fce9e9;\n  --sidebar: #ffffff;\n  --sidebar-foreground: #15152b;\n  --sidebar-primary: #5636d3;\n  --sidebar-primary-foreground: #ffffff;\n  --sidebar-accent: #eeeafc;\n  --sidebar-accent-foreground: #5636d3;\n  --sidebar-border: #e6e6ef;\n  --sidebar-ring: #5636d3;\n\n  --chart-1: #ff872c;\n  --chart-2: #3172b7;\n  --chart-3: #12a454;\n  --chart-4: #e83f5b;\n  --chart-5: #5636d3;\n  --chart-other: #969cb3;\n}\n\n.dark {\n  color-scheme: dark;\n  --background: #312e38;\n  --foreground: #f4ede8;\n  --card: #232129;\n  --card-foreground: #f4ede8;\n  --popover: #232129;\n  --popover-foreground: #f4ede8;\n  --primary: #6c4cf0;\n  --primary-foreground: #ffffff;\n  --primary-text: #b9abff;\n  --primary-soft: #2f2760;\n  --secondary: #3e3b47;\n  --secondary-foreground: #f4ede8;\n  --muted: #3e3b47;\n  --muted-foreground: #a3a9bf;\n  --accent: #3e3b47;\n  --accent-foreground: #f4ede8;\n  --destructive: #d4344f;\n  --destructive-foreground: #ffffff;\n  --border: #3e3b47;\n  --input: #6e6a80;\n  --ring: #b9abff;\n  --success: #3dd68c;\n  --success-soft: #173a2b;\n  --danger: #ff7d7d;\n  --danger-soft: #4a2226;\n  --sidebar: #28262e;\n  --sidebar-foreground: #f4ede8;\n  --sidebar-primary: #6c4cf0;\n  --sidebar-primary-foreground: #ffffff;\n  --sidebar-accent: #3e3b47;\n  --sidebar-accent-foreground: #f4ede8;\n  --sidebar-border: #3e3b47;\n  --sidebar-ring: #b9abff;\n}\n\n@theme {\n  --color-background: var(--background);\n  --color-foreground: var(--foreground);\n  --color-card: var(--card);\n  --color-card-foreground: var(--card-foreground);\n  --color-popover: var(--popover);\n  --color-popover-foreground: var(--popover-foreground);\n  --color-primary: var(--primary);\n  --color-primary-foreground: var(--primary-foreground);\n  --color-primary-text: var(--primary-text);\n  --color-primary-soft: var(--primary-soft);\n  --color-secondary: var(--secondary);\n  --color-secondary-foreground: var(--secondary-foreground);\n  --color-muted: var(--muted);\n  --color-muted-foreground: var(--muted-foreground);\n  --color-accent: var(--accent);\n  --color-accent-foreground: var(--accent-foreground);\n  --color-destructive: var(--destructive);\n  --color-destructive-foreground: var(--destructive-foreground);\n  --color-border: var(--border);\n  --color-input: var(--input);\n  --color-ring: var(--ring);\n  --color-success: var(--success);\n  --color-success-soft: var(--success-soft);\n  --color-danger: var(--danger);\n  --color-danger-soft: var(--danger-soft);\n  --color-sidebar: var(--sidebar);\n  --color-sidebar-foreground: var(--sidebar-foreground);\n  --color-sidebar-primary: var(--sidebar-primary);\n  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);\n  --color-sidebar-accent: var(--sidebar-accent);\n  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);\n  --color-sidebar-border: var(--sidebar-border);\n  --color-sidebar-ring: var(--sidebar-ring);\n  --color-chart-1: var(--chart-1);\n  --color-chart-2: var(--chart-2);\n  --color-chart-3: var(--chart-3);\n  --color-chart-4: var(--chart-4);\n  --color-chart-5: var(--chart-5);\n  --color-chart-other: var(--chart-other);\n  --font-serif: var(--font-roboto-slab);\n  --radius-sm: calc(var(--radius) - 4px);\n  --radius-md: calc(var(--radius) - 2px);\n  --radius-lg: var(--radius);\n  --radius-xl: calc(var(--radius) + 4px);\n  --radius-2xl: calc(var(--radius) + 8px);\n  --radius-3xl: calc(var(--radius) + 12px);\n  --radius-4xl: calc(var(--radius) + 16px);\n}\n\n@layer base {\n  * {\n    @apply border-border outline-ring/50;\n  }\n  body {\n    @apply bg-background text-foreground;\n    font-family: var(--font-roboto-slab), serif;\n  }\n\n  /* Autofill overrides */\n  input:-webkit-autofill,\n  input:-webkit-autofill:hover,\n  input:-webkit-autofill:focus,\n  input:-webkit-autofill:active {\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: var(--foreground);\n    transition: background-color 5000s ease-in-out 0s;\n    box-shadow: inset 0 0 20px 20px var(--card);\n  }\n}",
                  "lineHeight": 1.6,
                  "fontFamily": "Roboto Mono",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
